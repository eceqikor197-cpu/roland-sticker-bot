# =====================================================================
# roland-sticker-bot — Шаблон конфигурации переменных окружения (.env)
# Скопируйте этот файл в .env и укажите ваши параметры: cp .env.example .env
# =====================================================================

# 1. Telegram Bot Token (получите у @BotFather) [ОБЯЗАТЕЛЬНО]
PLOTTER_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Идентификаторы администраторов в Telegram (через запятую) [ОБЯЗАТЕЛЬНО]
ADMIN_IDS=870592714

# 3. Веб-админка и безопасность доступа
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8090
ADMIN_WEB_PASSWORD=change_this_to_a_strong_password
ADMIN_WEB_COOKIE_SECURE=false

# 4. Приватность и хранение данных (GDPR / Privacy)
# Live-шпион по умолчанию выключен (false). Включение админом через /spy
LIVE_SPY_DEFAULT=false
# Срок хранения файлов и заданий на сервере в часах (168.0 = 7 дней)
JOB_RETENTION_HOURS=168.0

# 5. Автономный комбайн стикеров (Harvester)
# Сборщик по умолчанию отключен (false)
HARVESTER_ENABLED=false
# Доступность веб-каталога без входа администратора (по умолчанию false — закрыт)
PUBLIC_CATALOG=false

# 6. База данных SQLite (WAL-режим)
STORAGE_DB_PATH=bot_storage.db

# 7. Интеграция с плоттером Roland (Hot Folder)
# Разрешить ли обычным пользователям прямую отправку в Hot Folder без аппрува админа
ALLOW_USER_HOT_FOLDER=false

# 8. Публичный туннель (по умолчанию выключен ради безопасности)
ENABLE_PUBLIC_TUNNEL=false

# 9. Лимит пикселей входных изображений (защита от DecompressionBomb)
MAX_IMAGE_PIXELS=60000000
