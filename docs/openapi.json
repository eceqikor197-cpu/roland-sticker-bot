{
  "openapi": "3.1.0",
  "info": {
    "title": "Roland Stickerbomb API",
    "description": "REST API для каталога макетов и кастомайзера стикербомбинга",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Проверка работоспособности сервиса",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stickers": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Список стикеров каталога с пагинацией и фильтрами",
        "operationId": "get_stickers_api_v1_stickers_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Номер страницы",
              "default": 1,
              "title": "Page"
            },
            "description": "Номер страницы"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Количество элементов на странице",
              "default": 30,
              "title": "Page Size"
            },
            "description": "Количество элементов на странице"
          },
          {
            "name": "asset_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Тип макета (single_sticker, pack_sheet)",
              "default": "single_sticker",
              "title": "Asset Type"
            },
            "description": "Тип макета (single_sticker, pack_sheet)"
          },
          {
            "name": "category_lvl1",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Фильтр по категории 1 уровня",
              "title": "Category Lvl1"
            },
            "description": "Фильтр по категории 1 уровня"
          },
          {
            "name": "category_lvl2",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Фильтр по подкатегории 2 уровня",
              "title": "Category Lvl2"
            },
            "description": "Фильтр по подкатегории 2 уровня"
          },
          {
            "name": "folder_slug",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Слаг папки темы",
              "title": "Folder Slug"
            },
            "description": "Слаг папки темы"
          },
          {
            "name": "topic_name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Название темы",
              "title": "Topic Name"
            },
            "description": "Название темы"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Поисковый запрос по названию или теме",
              "title": "Search"
            },
            "description": "Поисковый запрос по названию или теме"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StickerListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stickers/{asset_id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Детальная информация о макете",
        "operationId": "get_sticker_detail_api_v1_stickers__asset_id__get",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Asset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StickerDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stickers/{asset_id}/image": {
      "get": {
        "tags": [
          "Images"
        ],
        "summary": "Раздача изображений макетов (thumb, preview, full)",
        "operationId": "get_sticker_image_api_v1_stickers__asset_id__image_get",
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Asset Id"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Размер: thumb (256px), preview (1024px), full (оригинал)",
              "default": "preview",
              "title": "Size"
            },
            "description": "Размер: thumb (256px), preview (1024px), full (оригинал)"
          },
          {
            "name": "if-none-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Иерархия категорий и тем каталога",
        "operationId": "get_categories_api_v1_categories_get",
        "parameters": [
          {
            "name": "asset_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Тип макетов",
              "default": "single_sticker",
              "title": "Asset Type"
            },
            "description": "Тип макетов"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryTree"
                  },
                  "title": "Response Get Categories Api V1 Categories Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tags": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Список популярных тегов каталога с частотой использования",
        "operationId": "get_tags_api_v1_tags_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Количество возвращаемых тегов",
              "default": 50,
              "title": "Limit"
            },
            "description": "Количество возвращаемых тегов"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TagInfo"
                  },
                  "title": "Response Get Tags Api V1 Tags Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/onboarding/cards": {
      "get": {
        "tags": [
          "Recommender"
        ],
        "summary": "Разнообразный набор карточек для онбординга вкуса (FPS)",
        "operationId": "get_onboarding_cards_api_v1_onboarding_cards_get",
        "parameters": [
          {
            "name": "n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Количество карточек для онбординга",
              "default": 12,
              "title": "N"
            },
            "description": "Количество карточек для онбординга"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StickerSummary"
                  },
                  "title": "Response Get Onboarding Cards Api V1 Onboarding Cards Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/taste/profile": {
      "post": {
        "tags": [
          "Recommender"
        ],
        "summary": "Расчет вкусового профиля по лайкам и дизлайкам",
        "operationId": "compute_taste_profile_api_v1_taste_profile_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TasteProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TasteProfileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommend": {
      "post": {
        "tags": [
          "Recommender"
        ],
        "summary": "Персональные рекомендации с MMR диверсификацией",
        "operationId": "get_recommendations_api_v1_recommend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryLevel2": {
        "properties": {
          "category_lvl2": {
            "type": "string",
            "title": "Category Lvl2",
            "description": "Название подкатегории"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicInfo"
            },
            "type": "array",
            "title": "Topics",
            "description": "Темы подкатегории"
          }
        },
        "type": "object",
        "required": [
          "category_lvl2"
        ],
        "title": "CategoryLevel2",
        "description": "Подкатегория 2-го уровня с темами."
      },
      "CategoryTree": {
        "properties": {
          "category_lvl1": {
            "type": "string",
            "title": "Category Lvl1",
            "description": "Основная категория 1-го уровня"
          },
          "subcategories": {
            "items": {
              "$ref": "#/components/schemas/CategoryLevel2"
            },
            "type": "array",
            "title": "Subcategories",
            "description": "Список подкатегорий"
          }
        },
        "type": "object",
        "required": [
          "category_lvl1"
        ],
        "title": "CategoryTree",
        "description": "Иерархия категорий каталога (дерево)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Статус сервиса",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Версия API",
            "default": "0.1.0"
          }
        },
        "type": "object",
        "title": "HealthResponse",
        "description": "Ответ проверки работоспособности сервиса."
      },
      "PaginationMeta": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page",
            "description": "Номер текущей страницы (1-based)"
          },
          "page_size": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Page Size",
            "description": "Количество элементов на странице"
          },
          "total_items": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Items",
            "description": "Общее число элементов по фильтру"
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Pages",
            "description": "Общее число страниц"
          },
          "has_next": {
            "type": "boolean",
            "title": "Has Next",
            "description": "Есть ли следующая страница"
          },
          "has_prev": {
            "type": "boolean",
            "title": "Has Prev",
            "description": "Есть ли предыдущая страница"
          }
        },
        "type": "object",
        "required": [
          "page",
          "page_size",
          "total_items",
          "total_pages",
          "has_next",
          "has_prev"
        ],
        "title": "PaginationMeta",
        "description": "Метаданные пагинации."
      },
      "RecommendConstraints": {
        "properties": {
          "max_per_topic": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Per Topic",
            "description": "Максимум стикеров из одной темы",
            "default": 3
          },
          "min_unique_topics": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Min Unique Topics",
            "description": "Минимум уникальных тем в выдаче",
            "default": 5
          }
        },
        "type": "object",
        "title": "RecommendConstraints",
        "description": "Ограничения диверсификации для рекомендаций."
      },
      "RecommendRequest": {
        "properties": {
          "profile_vector": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Vector",
            "description": "Вектор вкусового профиля"
          },
          "liked": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Liked",
            "description": "Список ID лайкнутых стикеров"
          },
          "disliked": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Disliked",
            "description": "Список ID дизлайкнутых стикеров"
          },
          "count": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Count",
            "description": "Количество рекомендаций",
            "default": 20
          },
          "constraints": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecommendConstraints"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ограничения диверсификации"
          },
          "include_liked": {
            "type": "boolean",
            "title": "Include Liked",
            "description": "Включать ли уже лайкнутые стикеры в выдачу",
            "default": false
          }
        },
        "type": "object",
        "title": "RecommendRequest",
        "description": "Запрос на получение персональных рекомендаций."
      },
      "RecommendResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RecommendedSticker"
            },
            "type": "array",
            "title": "Items",
            "description": "Список рекомендованных стикеров"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Количество возвращенных рекомендаций"
          },
          "is_cold_start": {
            "type": "boolean",
            "title": "Is Cold Start",
            "description": "Флаг режима холодного старта",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "total"
        ],
        "title": "RecommendResponse",
        "description": "Ответ с персональными рекомендациями."
      },
      "RecommendedSticker": {
        "properties": {
          "asset_id": {
            "type": "string",
            "title": "Asset Id",
            "description": "Уникальный идентификатор стикера"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Название стикера"
          },
          "topic_name": {
            "type": "string",
            "title": "Topic Name",
            "description": "Название темы"
          },
          "folder_slug": {
            "type": "string",
            "title": "Folder Slug",
            "description": "Слаг темы"
          },
          "category_lvl1": {
            "type": "string",
            "title": "Category Lvl1",
            "description": "Основная категория (уровень 1)"
          },
          "category_lvl2": {
            "type": "string",
            "title": "Category Lvl2",
            "description": "Подкатегория (уровень 2)"
          },
          "asset_type": {
            "type": "string",
            "title": "Asset Type",
            "description": "Тип макета (single_sticker, pack_sheet, etc.)"
          },
          "width_mm": {
            "type": "number",
            "title": "Width Mm",
            "description": "Физическая ширина в миллиметрах"
          },
          "height_mm": {
            "type": "number",
            "title": "Height Mm",
            "description": "Физическая высота в миллиметрах"
          },
          "aspect": {
            "type": "number",
            "title": "Aspect",
            "description": "Пропорция растра (ширина / высота)",
            "default": 1.0
          },
          "aspect_ratio": {
            "type": "number",
            "title": "Aspect Ratio",
            "description": "Пропорция растра (алиас для обратной совместимости)",
            "default": 1.0
          },
          "alpha_coverage": {
            "type": "number",
            "title": "Alpha Coverage",
            "description": "Доля непрозрачных пикселей (0.0..1.0)",
            "default": 0.0
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "description": "Список тегов макета"
          },
          "palette": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Palette",
            "description": "5 доминирующих HEX-цветов"
          },
          "license": {
            "type": "string",
            "title": "License",
            "description": "Тип лицензии (own, licensed, cc0, unknown)"
          },
          "usable_in_service": {
            "type": "boolean",
            "title": "Usable In Service",
            "description": "Доступен ли макет для использования в сервисе"
          },
          "thumb_url": {
            "type": "string",
            "title": "Thumb Url",
            "description": "URL миниатюры (до 256px, WebP)"
          },
          "preview_url": {
            "type": "string",
            "title": "Preview Url",
            "description": "URL превью (до 1024px, WebP)"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Оценка соответствия MMR",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "title",
          "topic_name",
          "folder_slug",
          "category_lvl1",
          "category_lvl2",
          "asset_type",
          "width_mm",
