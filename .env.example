# Telegram Bot Token (from @BotFather)
PLOTTER_BOT_TOKEN=your_telegram_bot_token_here

# Приватность и хранение макетов (Фаза 4)
# По умолчанию Live-шпион выключен (false). Включение администратором через команду /spy
LIVE_SPY_DEFAULT=false

# Срок автоматического хранения макетов и файлов на сервере (в часах, 168 = 7 дней)
JOB_RETENTION_HOURS=168

# Безопасность парсера и каталога Harvester (Фаза 5)
# По умолчанию парсер отключен (false).
HARVESTER_ENABLED=false

# Доступность веб-каталога без входа администратора (по умолчанию false — закрыт)
PUBLIC_CATALOG=false

